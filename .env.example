# .env is parsed automatically; exported environment variables take precedence.
ANALYST_DATA_DIR=.data
ANALYST_MAX_UPLOAD_MB=20
ANALYST_JOB_TIMEOUT=60

# Gemini endpoint documented by Google. No API key belongs in frontend code.
ANALYST_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Choose a model available to your AI Studio project; the docs currently use this example.
ANALYST_LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
# Sends question + column schema + plan/code; never sends file rows or computed values.
ANALYST_LLM_ALLOW_REMOTE=true
ANALYST_LLM_JSON_MODE=schema

# Local: keep empty. HTTPS server: e.g. https://analyst.company.uz
# A non-empty origin enables Secure cookies and disables browser first-account setup.
# Railway RAILWAY_PUBLIC_DOMAIN qiymatidan HTTPS origin avtomatik olinadi.
ANALYST_PUBLIC_ORIGIN=
ANALYST_SESSION_HOURS=12

# Google OAuth web application credentials (different from GEMINI_API_KEY).
# Register http://127.0.0.1:8000/api/v1/auth/google/callback as Authorized redirect URI.
ANALYST_GOOGLE_CLIENT_ID=
ANALYST_GOOGLE_CLIENT_SECRET=
# Production signup: set a verified Google Workspace domain, e.g. company.uz.
# If empty on an HTTPS server, only already-linked Google accounts can sign in.
ANALYST_GOOGLE_ALLOWED_DOMAIN=
